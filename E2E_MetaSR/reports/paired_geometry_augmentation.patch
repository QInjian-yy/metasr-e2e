+    def test_joint_gradients_and_geometry_independent_of_microbatch(self):
+        dataset = Camelyon16WSI([self.sample], augmentation={"enabled": True})
+        model = self.model()
+        for coefficient in (0, 0.1):
+            self.config["lambda_sr"] = coefficient
